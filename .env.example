# ============================================================
# OneOps backend environment — copy to .env (or set in cPanel
# "Setup Node.js App" → Environment variables) and fill in.
# NEVER commit the real .env file.
# ============================================================

# --- MySQL (OneOps database; same DB where the SQL migrations were imported)
DB_HOST=localhost
DB_PORT=3306
DB_USER=cpaneluser_oneops
DB_PASSWORD=your-db-password
DB_NAME=cpaneluser_oneops
DB_CONNECTION_LIMIT=5

# --- Sessions
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 16 chars or login stays disabled.
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_SECONDS=28800
# Set to true when serving over HTTPS (production usually yes)
SESSION_SECURE_COOKIES=false

# --- First-run admin (optional)
# If the users table is empty at startup, an 'admin' super_admin account is
# created with this password. Leave empty to disable.
BOOTSTRAP_ADMIN_PASSWORD=

# --- Cloudflare R2 (Data Warrior file storage)
# Create S3 API credentials in Cloudflare → R2 → Manage API tokens.
# Scope: Object Read + Object Write, restricted to the bucket below.
# NEVER use the Global API Key or dashboard login.
R2_ACCOUNT_ID=483b90fc7535fc1e66e05dc02469c696
R2_ACCESS_KEY_ID=generate-new-s3-api-access-key
R2_SECRET_ACCESS_KEY=generate-new-s3-api-secret-key
R2_BUCKET_NAME=data-warrion
R2_ENDPOINT=https://483b90fc7535fc1e66e05dc02469c696.r2.cloudflarestorage.com
R2_REGION=auto
R2_FORCE_PATH_STYLE=true
R2_PRESIGNED_URL_EXPIRY=300
R2_MAX_FILE_SIZE=52428800
# Optional public CDN base URL (leave empty — bucket stays private)
R2_PUBLIC_URL=

# --- Server
PORT=3001
NODE_ENV=production

# --- SiCepat (Number Rechecking proxy)
SICEPAT_BASE_URL=https://podapi.sicepat.com/
