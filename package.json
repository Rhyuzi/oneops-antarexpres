{
  "name": "sicepat-bulk-phone-rechecker",
  "version": "1.0.0",
  "private": true,
  "description": "Local tool to recheck recipient phone numbers from SiCepat AWB numbers in bulk.",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "start": "node server/index.js"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "express": "^4.19.2",
    "lucide-vue-next": "^0.441.0",
    "vue": "3.4.38",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.6.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "5.4.5",
    "vite": "^4.5.3",
    "vue-tsc": "1.8.27"
  }
}
